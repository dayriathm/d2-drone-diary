*.db-wal
*.db-shm
*.db-journal

# Compiled Binaries & Native Addons
*.exe
*.dll
*.node
*.pdb

# Logs & Temporary Workspaces
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*

